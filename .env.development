VITE_HTTP_PROXY=Y
# 轻易不要切换环境参数，会给联合开发的其他人带来困扰
# static：代表自动生成所有路由
# dynamic：代表动态获取路由
# VITE_AUTH_ROUTE_MODE=dynamic
VITE_AUTH_ROUTE_MODE=dynamic
# VITE_AUTO_LOGIN_PASSWORD=123456

# ThingsVis Studio URL for development
VITE_THINGSVIS_STUDIO_URL=http://localhost:3000/main
VITE_THINGSVIS_API_URL=http://localhost:8000
#VITE_THINGSVIS_STUDIO_URL=http://c.thingspanel.cn:7050/main
#VITE_THINGSVIS_API_URL=http://c.thingspanel.cn:7050

# Market URL for development
VITE_MARKET_URL=https://r.thingspanel.cn
# VITE_MARKET_URL=http://localhost:5173
# 自动化引擎（独立 Encore 服务）开发代理目标；留空则 /automation-core 不可用，页面会明确提示而不是静默失败
# 连接统一业务网关时，在 .env.development.local 中设为 business，保留网关所需的 /automation-core 前缀。
VITE_AUTOMATION_DEV_PROXY_TARGET=http://127.0.0.1:14000
